<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:se020="http://www.atrias.be/msg/umig/02-16/Settle/SnapshotMasterDataGas" targetNamespace="http://www.atrias.be/msg/umig/02-16/Settle/SnapshotMasterDataGas" elementFormDefault="qualified" version="02-16.001">
	<xs:element name="SnapshotMasterDataGas" type="se020:SnapshotMasterDataGas"/>
	<xs:complexType name="AggregatedReceptionStation">
		<xs:sequence>
			<xs:element name="EanGsrn" type="se020:EanGsrn_Type"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AllocationSnapshot">
		<xs:sequence>
			<xs:element name="Month" type="xs:gYearMonth"/>
			<xs:element name="AllocationSnapshotSdp" type="se020:AllocationSnapshotSdp" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AllocationSnapshotSdp">
		<xs:sequence>
			<xs:element name="MarketServiceDeliveryPoint" type="se020:MarketServiceDeliveryPoint"/>
			<xs:element name="InternalMarketSdpConfiguration" type="se020:InternalMarketSdpConfiguration"/>
			<xs:element name="ExternalMarketSdpConfiguration" type="se020:ExternalMarketSdpConfiguration" minOccurs="0"/>
			<xs:element name="AllocationSnapshotSdpRegister" type="se020:AllocationSnapshotSdpRegister"/>
			<xs:element name="AggregatedReceptionStation" type="se020:AggregatedReceptionStation"/>
			<xs:element name="GridAccessProvider" type="se020:GridAccessProvider"/>
			<xs:element name="BalanceResponsible" type="se020:BalanceResponsible"/>
			<xs:element name="BalanceSupplier" type="se020:BalanceSupplier"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AllocationSnapshotSdpRegister">
		<xs:sequence>
			<xs:element name="Direction" type="se020:Direction_Enum"/>
			<xs:element name="LoadProfileCode" type="se020:LoadProfileCode_Enum"/>
			<xs:element name="TimeOfUse" type="se020:TimeOfUse_Enum"/>
			<xs:element name="EnergyType" type="se020:EnergyType_Enum"/>
			<xs:element name="MeteringMethod" type="se020:MeteringMethod_Enum"/>
			<xs:element name="Unit" type="se020:RegisterUnit_Enum"/>
			<xs:element name="VirtualBaseFlag" type="se020:booleanTF" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BalanceResponsible">
		<xs:sequence>
			<xs:element name="EanGln" type="se020:EanGln_Type"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BalanceSupplier">
		<xs:sequence>
			<xs:element name="EanGln" type="se020:EanGln_Type"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ExternalMarketSdpConfiguration">
		<xs:sequence>
			<xs:element name="MeteringRegime" type="se020:MeteringRegime_Enum" minOccurs="0"/>
			<xs:element name="InformationFrequency" type="se020:InformationFrequency_Enum" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="GridAccessProvider">
		<xs:sequence>
			<xs:element name="EanGln" type="se020:EanGln_Type"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HeaderMessage">
		<xs:sequence>
			<xs:element name="MessageId" type="se020:GUID_Type"/>
			<xs:element name="MessageDateTime" type="se020:UTCOffsetDateTime"/>
			<xs:element name="Module" type="se020:BusinessReasonCode_Enum"/>
			<xs:element name="Sector" type="se020:Sector_Enum"/>
			<xs:element name="SenderId" type="se020:EanGln_Type"/>
			<xs:element name="ReceiverId" type="se020:EanGln_Type"/>
			<xs:element name="Version" type="se020:Version_Type"/>
			<xs:element name="CommonId" type="se020:GUID_Type"/>
			<xs:element name="Sequence" type="xs:positiveInteger"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HeaderPayload">
		<xs:sequence>
			<xs:element name="TransactionId" type="se020:string50"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InternalMarketSdpConfiguration">
		<xs:sequence>
			<xs:element name="DgoBillFrequency" type="se020:DgoBillFrequency_Enum"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MarketServiceDeliveryPoint">
		<xs:sequence>
			<xs:element name="EanGsrn" type="se020:EanGsrn_Type"/>
			<xs:element name="ServiceComponentId" type="se020:MarketServiceComponentId_Enum"/>
			<xs:element name="BalanceSupplierKey" type="se020:EanGsrn_Type"/>
			<xs:element name="SettlementMethod" type="se020:SettlementMethod_Enum"/>
			<xs:element name="UnoccupiedLocationFlag" type="se020:booleanTF"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Payload">
		<xs:sequence>
			<xs:element name="HeaderPayload" type="se020:HeaderPayload"/>
			<xs:element name="AllocationSnapshot" type="se020:AllocationSnapshot"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SnapshotMasterDataGas">
		<xs:sequence>
			<xs:element name="HeaderMessage" type="se020:HeaderMessage"/>
			<xs:element name="Payload" type="se020:Payload"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="booleanTF">
		<xs:restriction base="xs:boolean">
			<xs:pattern value="true|false"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BusinessReasonCode_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E44"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DgoBillFrequency_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="P1M"/>
			<xs:enumeration value="P1Y"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Direction_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E17"/>
			<xs:enumeration value="E18"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGln_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{13}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGsrn_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{18}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EnergyType_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="8716867000030"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GUID_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="InformationFrequency_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="P1M"/>
			<xs:enumeration value="P6M"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="LoadProfileCode_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="S02"/>
			<xs:enumeration value="S30"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MarketServiceComponentId_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SC_INJECTI"/>
			<xs:enumeration value="SC_OFFTAKE"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MeteringMethod_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E13"/>
			<xs:enumeration value="E14"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MeteringRegime_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="R1"/>
			<xs:enumeration value="R3"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RegisterUnit_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="KWH"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Sector_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="27"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SettlementMethod_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="BU7"/>
			<xs:enumeration value="BU8"/>
			<xs:enumeration value="BU9"/>
			<xs:enumeration value="E01"/>
			<xs:enumeration value="E02"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="string50">
		<xs:restriction base="xs:string">
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TimeOfUse_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="B37"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UTCOffsetDateTime">
		<xs:restriction base="xs:dateTime">
			<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\.[0-9]{1,3})?\+01:00"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Version_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}-[0-9]{2}\.[0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
