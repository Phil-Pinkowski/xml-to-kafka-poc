<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:se038="http://www.atrias.be/msg/umig/02-21/Settle/ReconciliationResultsBySDP" targetNamespace="http://www.atrias.be/msg/umig/02-21/Settle/ReconciliationResultsBySDP" elementFormDefault="qualified" version="02-21.001">
	<xs:element name="ReconciliationResultsBySdp" type="se038:ReconciliationResultsBySdp"/>
	<xs:complexType name="CalculatedRegister">
		<xs:sequence>
			<xs:element name="Direction" type="se038:Direction_Enum"/>
			<xs:element name="TimeOfUse" type="se038:TimeOfUse_Enum"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HeaderMessage">
		<xs:sequence>
			<xs:element name="MessageId" type="se038:GUID_Type"/>
			<xs:element name="MessageDateTime" type="se038:UTCOffsetDateTime"/>
			<xs:element name="Module" type="se038:BusinessReasonCode_Enum"/>
			<xs:element name="Sector" type="se038:Sector_Enum"/>
			<xs:element name="SenderId" type="se038:EanGln_Type"/>
			<xs:element name="ReceiverId" type="se038:EanGln_Type"/>
			<xs:element name="Version" type="se038:Version_Type"/>
			<xs:element name="CommonId" type="se038:GUID_Type"/>
			<xs:element name="Sequence" type="xs:positiveInteger"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HeaderPayload">
		<xs:sequence>
			<xs:element name="TransactionId" type="se038:string50"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MarketServiceDeliveryPoint">
		<xs:sequence>
			<xs:element name="EanGsrn" type="se038:EanGsrn_Type"/>
			<xs:element name="ServiceComponentId" type="se038:MarketServiceComponentId_Enum"/>
			<xs:element name="BalanceSupplierKey" type="se038:EanGsrn_Type"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Payload">
		<xs:sequence>
			<xs:element name="HeaderPayload" type="se038:HeaderPayload"/>
			<xs:element name="ReconciliationRun" type="se038:ReconciliationRun"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReconciliationPhotoSdp">
		<xs:sequence>
			<xs:element name="VolumeVi" type="se038:decimal2010" minOccurs="0"/>
			<xs:element name="VolumeViUnit" type="se038:RegisterUnit_Enum" minOccurs="0"/>
			<xs:element name="VipStartDateTime" type="se038:UTCOffsetDateTime" minOccurs="0"/>
			<xs:element name="VipEndDateTime" type="se038:UTCOffsetDateTime" minOccurs="0"/>
			<xs:element name="VolumeVa" type="se038:decimal2010" minOccurs="0"/>
			<xs:element name="VolumeVaUnit" type="se038:RegisterUnit_Enum" minOccurs="0"/>
			<xs:element name="VapStartDateTime" type="se038:UTCOffsetDateTime" minOccurs="0"/>
			<xs:element name="VapEndDateTime" type="se038:UTCOffsetDateTime" minOccurs="0"/>
			<xs:element name="VolumeReconciliation" type="se038:decimal2010" minOccurs="0"/>
			<xs:element name="VolumeReconciliationUnit" type="se038:RegisterUnit_Enum" minOccurs="0"/>
			<xs:element name="MarketServiceDeliveryPoint" type="se038:MarketServiceDeliveryPoint"/>
			<xs:element name="CalculatedRegister" type="se038:CalculatedRegister" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReconciliationResultsBySdp">
		<xs:sequence>
			<xs:element name="HeaderMessage" type="se038:HeaderMessage"/>
			<xs:element name="Payload" type="se038:Payload"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReconciliationRun">
		<xs:sequence>
			<xs:element name="Id" type="se038:string50"/>
			<xs:element name="ReconciliationType" type="se038:ReconciliationType_Enum"/>
			<xs:element name="ReconciliationMonth" type="xs:gYearMonth"/>
			<xs:element name="ReferenceMonth" type="xs:gYearMonth"/>
			<xs:element name="ReconciliationPhotoSdp" type="se038:ReconciliationPhotoSdp" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="BusinessReasonCode_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E43"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="decimal2010">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="10"/>
			<xs:totalDigits value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Direction_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E17"/>
			<xs:enumeration value="E18"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGln_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{13}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGsrn_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{18}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GUID_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MarketServiceComponentId_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SC_COMMINJ"/>
			<xs:enumeration value="SC_COMMOFF"/>
			<xs:enumeration value="SC_COMPOFF"/>
			<xs:enumeration value="SC_COMPOFI"/>
			<xs:enumeration value="SC_CONPROD"/>
			<xs:enumeration value="SC_CONSUMP"/>
			<xs:enumeration value="SC_INJECTI"/>
			<xs:enumeration value="SC_OFFINJE"/>
			<xs:enumeration value="SC_OFFTAKE"/>
			<xs:enumeration value="SC_PRODUCT"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ReconciliationType_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="X"/>
			<xs:enumeration value="Y"/>
			<xs:enumeration value="Z"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RegisterUnit_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="KWH"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Sector_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="23"/>
			<xs:enumeration value="27"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="string50">
		<xs:restriction base="xs:string">
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TimeOfUse_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="B36"/>
			<xs:enumeration value="B37"/>
			<xs:enumeration value="E10"/>
			<xs:enumeration value="E11"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UTCOffsetDateTime">
		<xs:restriction base="xs:dateTime">
			<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\.[0-9]{1,3})?\+01:00"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Version_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}-[0-9]{2}\.[0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
