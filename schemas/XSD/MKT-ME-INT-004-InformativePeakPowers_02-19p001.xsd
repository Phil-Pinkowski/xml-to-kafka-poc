<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:me004="http://www.atrias.be/msg/umig/02-19/Measure/InformativePeakPowers" targetNamespace="http://www.atrias.be/msg/umig/02-19/Measure/InformativePeakPowers" elementFormDefault="qualified" version="02-19.001">
	<xs:element name="InformativePeakPowers" type="me004:InformativePeakPowers"/>
	<xs:complexType name="CalculatedMeter">
		<xs:sequence>
			<xs:element name="CalculatedRegister" type="me004:CalculatedRegister"/>
		</xs:sequence>
		<xs:attribute name="Id" type="me004:EanGsrn_Type" use="required"/>
	</xs:complexType>
	<xs:complexType name="CalculatedRegister">
		<xs:sequence>
			<xs:element name="Power" type="me004:Power" minOccurs="2" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="Id" type="me004:string50" use="required"/>
	</xs:complexType>
	<xs:complexType name="HeaderMessage">
		<xs:sequence/>
		<xs:attribute name="MessageDateTime" type="me004:UTCOffsetDateTime" use="required"/>
		<xs:attribute name="Module" type="me004:BusinessReasonCode_Enum" use="required"/>
		<xs:attribute name="Sector" type="me004:Sector_Enum" use="required"/>
		<xs:attribute name="SenderId" type="me004:EanGln_Type" use="required"/>
		<xs:attribute name="ReceiverId" type="me004:EanGln_Type" use="required"/>
		<xs:attribute name="Version" type="me004:Version_Type" use="required"/>
	</xs:complexType>
	<xs:complexType name="InformativePeakPowers">
		<xs:sequence>
			<xs:element name="HeaderMessage" type="me004:HeaderMessage"/>
			<xs:element name="MarketServiceDeliveryPoint" type="me004:MarketServiceDeliveryPoint"/>
		</xs:sequence>
		<xs:attribute name="EventId" type="me004:GUID_Type" use="required"/>
	</xs:complexType>
	<xs:complexType name="MarketServiceDeliveryPoint">
		<xs:sequence>
			<xs:element name="CalculatedMeter" type="me004:CalculatedMeter"/>
		</xs:sequence>
		<xs:attribute name="EanGsrn" type="me004:EanGsrn_Type" use="required"/>
		<xs:attribute name="ServiceComponentId" type="me004:MarketServiceComponentId_Enum" use="required"/>
	</xs:complexType>
	<xs:complexType name="Power">
		<xs:sequence/>
		<xs:attribute name="StartDateTime" type="me004:UTCOffsetDateTime" use="required"/>
		<xs:attribute name="EndDateTime" type="me004:UTCOffsetDateTime" use="required"/>
		<xs:attribute name="Type" type="me004:PowerType_Enum" use="required"/>
		<xs:attribute name="Quantity" type="me004:decimal2010" use="required"/>
		<xs:attribute name="Quality" type="me004:QuantityQuality_Enum" use="required"/>
	</xs:complexType>
	<xs:simpleType name="BusinessReasonCode_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E23"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="decimal2010">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="10"/>
			<xs:totalDigits value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGln_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{13}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGsrn_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{18}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GUID_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MarketServiceComponentId_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SC_INJECTI"/>
			<xs:enumeration value="SC_OFFTAKE"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PowerType_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PP"/>
			<xs:enumeration value="RMP"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="QuantityQuality_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="56"/>
			<xs:enumeration value="86"/>
			<xs:enumeration value="125"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Sector_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="23"/>
			<xs:enumeration value="27"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="string50">
		<xs:restriction base="xs:string">
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UTCOffsetDateTime">
		<xs:restriction base="xs:dateTime">
			<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\.[0-9]{1,3})?\+01:00"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Version_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}-[0-9]{2}\.[0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
