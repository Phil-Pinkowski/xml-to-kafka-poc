<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:me005="http://www.atrias.be/msg/umig/02-16/Measure/InformativeMeteredVolumesBySDP" targetNamespace="http://www.atrias.be/msg/umig/02-16/Measure/InformativeMeteredVolumesBySDP" elementFormDefault="qualified" version="02-16.001">
	<xs:element name="InformativeMeteredVolumesBySDP" type="me005:InformativeMeteredVolumesBySDP"/>
	<xs:complexType name="CalculatedMeter">
		<xs:sequence>
			<xs:element name="CalculatedRegister" type="me005:CalculatedRegister" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="Id" type="me005:EanGsrn_Type" use="required"/>
	</xs:complexType>
	<xs:complexType name="CalculatedRegister">
		<xs:sequence>
			<xs:element name="ConversionFactor" type="me005:ConversionFactor" minOccurs="0"/>
			<xs:element name="Volume" type="me005:Volume"/>
		</xs:sequence>
		<xs:attribute name="Id" type="me005:string50" use="required"/>
		<xs:attribute name="Unit" type="me005:RegisterUnit_Enum" use="required"/>
	</xs:complexType>
	<xs:complexType name="ConversionFactor">
		<xs:sequence/>
		<xs:attribute name="ConversionFactorValue" type="me005:decimal2010" use="required"/>
		<xs:attribute name="ConversionFactorUnit" type="me005:ConversionFactorUnit_Enum" use="required"/>
	</xs:complexType>
	<xs:complexType name="HeaderMessage">
		<xs:sequence/>
		<xs:attribute name="MessageId" type="me005:GUID_Type" use="required"/>
		<xs:attribute name="MessageDateTime" type="me005:UTCOffsetDateTime" use="required"/>
		<xs:attribute name="Module" type="me005:BusinessReasonCode_Enum" use="required"/>
		<xs:attribute name="Sector" type="me005:Sector_Enum" use="required"/>
		<xs:attribute name="SenderId" type="me005:EanGln_Type" use="required"/>
		<xs:attribute name="ReceiverId" type="me005:EanGln_Type" use="required"/>
		<xs:attribute name="Version" type="me005:Version_Type" use="required"/>
		<xs:attribute name="TicketNumber" type="me005:string50" use="optional"/>
	</xs:complexType>
	<xs:complexType name="Index">
		<xs:sequence/>
		<xs:attribute name="Type" type="me005:IndexType_Enum" use="required"/>
		<xs:attribute name="Quantity" type="me005:decimal2010" use="required"/>
		<xs:attribute name="Quality" type="me005:QuantityQuality_Enum" use="required"/>
		<xs:attribute name="AdjustmentReason" type="me005:AdjustmentReason_Enum" use="optional"/>
	</xs:complexType>
	<xs:complexType name="InformativeMeteredVolumesBySDP">
		<xs:sequence>
			<xs:element name="HeaderMessage" type="me005:HeaderMessage"/>
			<xs:element name="MarketServiceDeliveryPoint" type="me005:MarketServiceDeliveryPoint"/>
		</xs:sequence>
		<xs:attribute name="EventId" type="me005:GUID_Type" use="required"/>
	</xs:complexType>
	<xs:complexType name="MarketServiceDeliveryPoint">
		<xs:sequence>
			<xs:element name="PhysicalMeter" type="me005:PhysicalMeter" maxOccurs="unbounded"/>
			<xs:element name="CalculatedMeter" type="me005:CalculatedMeter" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="TransactionId" type="me005:GUID_Type" use="required"/>
		<xs:attribute name="EanGsrn" type="me005:EanGsrn_Type" use="required"/>
		<xs:attribute name="MeasuringStartDateTime" type="me005:UTCOffsetDateTime" use="required"/>
		<xs:attribute name="MeasuringEndDateTime" type="me005:UTCOffsetDateTime" use="required"/>
		<xs:attribute name="ServiceComponentId" type="me005:MarketServiceComponentId_Enum" use="required"/>
		<xs:attribute name="BalanceSupplierKey" type="me005:EanGsrn_Type" use="required"/>
	</xs:complexType>
	<xs:complexType name="PhysicalMeter">
		<xs:sequence>
			<xs:element name="PhysicalRegister" type="me005:PhysicalRegister" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="SerialNumber" type="me005:string50" use="required"/>
	</xs:complexType>
	<xs:complexType name="PhysicalRegister">
		<xs:sequence>
			<xs:element name="Index" type="me005:Index" maxOccurs="2"/>
		</xs:sequence>
		<xs:attribute name="Id" type="me005:string50" use="required"/>
		<xs:attribute name="Unit" type="me005:RegisterUnit_Enum" use="required"/>
	</xs:complexType>
	<xs:complexType name="Volume">
		<xs:sequence/>
		<xs:attribute name="Quantity" type="me005:decimal2010" use="required"/>
		<xs:attribute name="Quality" type="me005:QuantityQuality_Enum" use="required"/>
		<xs:attribute name="AdjustmentReason" type="me005:AdjustmentReason_Enum" use="optional"/>
	</xs:complexType>
	<xs:simpleType name="AdjustmentReason_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="24"/>
			<xs:enumeration value="40"/>
			<xs:enumeration value="B57"/>
			<xs:enumeration value="B58"/>
			<xs:enumeration value="B59"/>
			<xs:enumeration value="B86"/>
			<xs:enumeration value="B96"/>
			<xs:enumeration value="BCZ"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BusinessReasonCode_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E23"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ConversionFactorUnit_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E46"/>
			<xs:enumeration value="Z16"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="decimal2010">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="10"/>
			<xs:totalDigits value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGln_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{13}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGsrn_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{18}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GUID_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="IndexType_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="BE3"/>
			<xs:enumeration value="BE4"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MarketServiceComponentId_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SC_COMMINJ"/>
			<xs:enumeration value="SC_COMMOFF"/>
			<xs:enumeration value="SC_COMPOFF"/>
			<xs:enumeration value="SC_COMPOFI"/>
			<xs:enumeration value="SC_CONPROD"/>
			<xs:enumeration value="SC_CONSUMP"/>
			<xs:enumeration value="SC_INJECTI"/>
			<xs:enumeration value="SC_OFFINJE"/>
			<xs:enumeration value="SC_OFFTAKE"/>
			<xs:enumeration value="SC_PRODUCT"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="QuantityQuality_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="56"/>
			<xs:enumeration value="62"/>
			<xs:enumeration value="86"/>
			<xs:enumeration value="125"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RegisterUnit_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="KWH"/>
			<xs:enumeration value="KWT"/>
			<xs:enumeration value="KVR"/>
			<xs:enumeration value="MTQ"/>
			<xs:enumeration value="NM3"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Sector_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="23"/>
			<xs:enumeration value="27"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="string50">
		<xs:restriction base="xs:string">
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UTCOffsetDateTime">
		<xs:restriction base="xs:dateTime">
			<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\.[0-9]{1,3})?\+01:00"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Version_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}-[0-9]{2}\.[0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
