<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bi011="http://www.atrias.be/msg/umig/02-16/Bill/TransactionCostInvoicingDataBySdp" targetNamespace="http://www.atrias.be/msg/umig/02-16/Bill/TransactionCostInvoicingDataBySdp" elementFormDefault="qualified" version="02-16.001">
	<xs:element name="TransactionCostInvoicingDataBySdp" type="bi011:TransactionCostInvoicingDataBySdp"/>
	<xs:complexType name="BillLine">
		<xs:sequence>
			<xs:element name="Id" type="bi011:string50"/>
			<xs:element name="OriginalBillLineId" type="bi011:string50" minOccurs="0"/>
			<xs:element name="RelatedBillLineId" type="bi011:string50" minOccurs="0"/>
			<xs:element name="Amount" type="bi011:decimal1202"/>
			<xs:element name="Currency" type="bi011:Currency_Enum"/>
			<xs:element name="Quantity" type="bi011:decimal1707"/>
			<xs:element name="QuantityUnit" type="bi011:BilledQuantityUnit_Enum"/>
			<xs:element name="Price" type="bi011:decimal1707"/>
			<xs:element name="StartDate" type="xs:date"/>
			<xs:element name="EndDate" type="xs:date"/>
			<xs:element name="CreditLineIndicator" type="bi011:CreditLineIndicator_Type"/>
			<xs:element name="TariffComponent" type="bi011:TariffComponent"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Fee">
		<xs:sequence>
			<xs:element name="StartDate" type="xs:date"/>
			<xs:element name="EndDate" type="xs:date"/>
			<xs:element name="BillLine" type="bi011:BillLine" maxOccurs="unbounded"/>
			<xs:element name="Tariff" type="bi011:Tariff"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="GlobalisationCode">
		<xs:sequence>
			<xs:element name="Code" type="bi011:GlobalisationCode_Type"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HeaderMessage">
		<xs:sequence>
			<xs:element name="MessageId" type="bi011:GUID_Type"/>
			<xs:element name="MessageDateTime" type="bi011:UTCOffsetDateTime"/>
			<xs:element name="Module" type="bi011:BusinessReasonCode_Enum"/>
			<xs:element name="Label" type="bi011:LabelsCode_Enum"/>
			<xs:element name="Sector" type="bi011:Sector_Enum"/>
			<xs:element name="SenderId" type="bi011:EanGln_Type"/>
			<xs:element name="ReceiverId" type="bi011:EanGln_Type"/>
			<xs:element name="Version" type="bi011:Version_Type"/>
			<xs:element name="CommonId" type="bi011:GUID_Type"/>
			<xs:element name="Sequence" type="xs:positiveInteger"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HeaderPayload">
		<xs:sequence>
			<xs:element name="TransactionId" type="bi011:string50"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InternalMarketSdpConfiguration">
		<xs:sequence>
			<xs:element name="DgoBillFrequency" type="bi011:DgoBillFrequency_Enum"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Invoice">
		<xs:sequence>
			<xs:element name="CalculationDateTime" type="bi011:UTCOffsetDateTime"/>
			<xs:element name="PaperInvoiceDate" type="xs:date"/>
			<xs:element name="PaperInvoiceReference" type="bi011:alphanumeric25"/>
			<xs:element name="MarketServiceDeliveryPoint" type="bi011:MarketServiceDeliveryPoint" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MarketServiceDeliveryPoint">
		<xs:sequence>
			<xs:element name="EanGsrn" type="bi011:EanGsrn_Type"/>
			<xs:element name="ServiceComponentId" type="bi011:MarketServiceComponentId_Enum"/>
			<xs:element name="BalanceSupplierKey" type="bi011:EanGsrn_Type"/>
			<xs:element name="InternalMarketSdpConfiguration" type="bi011:InternalMarketSdpConfiguration"/>
			<xs:element name="Fee" type="bi011:Fee" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Payload">
		<xs:sequence>
			<xs:element name="HeaderPayload" type="bi011:HeaderPayload"/>
			<xs:element name="Invoice" type="bi011:Invoice"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Tariff">
		<xs:sequence>
			<xs:element name="Code" type="bi011:string25"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TariffComponent">
		<xs:sequence>
			<xs:element name="Code" type="bi011:string50"/>
			<xs:element name="VatRate" type="bi011:Percentage_Type"/>
			<xs:element name="GlobalisationCode" type="bi011:GlobalisationCode"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TransactionCostInvoicingDataBySdp">
		<xs:sequence>
			<xs:element name="HeaderMessage" type="bi011:HeaderMessage"/>
			<xs:element name="Payload" type="bi011:Payload"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="alphanumeric25">
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-zA-Z0-9]{1,25}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BilledQuantityUnit_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="EA"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BusinessReasonCode_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="E89"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CreditLineIndicator_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="\+|\-"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Currency_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="EUR"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="decimal1202">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="2"/>
			<xs:totalDigits value="12"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="decimal1707">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="7"/>
			<xs:totalDigits value="17"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DgoBillFrequency_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="P1M"/>
			<xs:enumeration value="P1Y"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGln_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{13}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EanGsrn_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{18}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GlobalisationCode_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[E|G][0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GUID_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="LabelsCode_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="BX7"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MarketServiceComponentId_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SC_COMMINJ"/>
			<xs:enumeration value="SC_COMMOFF"/>
			<xs:enumeration value="SC_COMPOFF"/>
			<xs:enumeration value="SC_COMPOFI"/>
			<xs:enumeration value="SC_CONPROD"/>
			<xs:enumeration value="SC_CONSUMP"/>
			<xs:enumeration value="SC_INJECTI"/>
			<xs:enumeration value="SC_OFFINJE"/>
			<xs:enumeration value="SC_OFFTAKE"/>
			<xs:enumeration value="SC_PRODUCT"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Percentage_Type">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="10"/>
			<xs:maxInclusive value="1"/>
			<xs:minInclusive value="0"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Sector_Enum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="23"/>
			<xs:enumeration value="27"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="string25">
		<xs:restriction base="xs:string">
			<xs:maxLength value="25"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="string50">
		<xs:restriction base="xs:string">
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UTCOffsetDateTime">
		<xs:restriction base="xs:dateTime">
			<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\.[0-9]{1,3})?\+01:00"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Version_Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}-[0-9]{2}\.[0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
